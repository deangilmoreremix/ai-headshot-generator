# Environment Configuration for AI Headshot Generator

# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL="your_supabase_url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# AI Headshot API (muapi.ai)
HEADSHOT_API_KEY="your_muapi_ai_key"
WEBHOOK_URL="your_webhook_url"  # Used for muapi.ai webhook callbacks

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dynamic UI Theme Configuration
# Choose between: indigo, emerald, rose, amber, violet, light, dark
NEXT_PUBLIC_THEME=indigo