# Environment Configuration for AI Headshot Generator (no-auth, user-provided muapi key)

# Supabase
NEXT_PUBLIC_SUPABASE_URL="your_supabase_url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# muapi.ai fallback key (used only if the user hasn't saved their own in Settings)
HEADSHOT_API_KEY="your_muapi_ai_key"

# Public webhook URL (muapi.ai calls this on completion)
WEBHOOK_URL="https://your-domain.com"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Theme
NEXT_PUBLIC_THEME=indigo